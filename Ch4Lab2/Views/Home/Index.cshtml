@model List<Character>
@{
    ViewData["Title"] = "List of Characters";
}

<div class="mb-2">
    <a asp-controller="" asp-action="Add"
       class="btn btn-primary">Add New Character</a>
    <a asp-controller="Home" asp-action="Index"
       class="btn btn-secondary">Back</a>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Class</th>
            <th>Ancestry</th>
            <th>Level</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var character in Model)
        {
            <tr>
                <td>@character.FirstName @character.LastName</td>
                <td>@character.Class.Name</td>
                <td>@character.Ancestry.AncestryName</td>
                <td>@character.Level</td>
                <td><a asp-controller="Character" asp-action="Stats"></a></td>
                <td>
                    
                </td>
            </tr>
        }
    </tbody>
</table>