@model List<Character>
@{
    ViewData["Title"] = "List of Characters";
}


<div class="mb-2 btn-group">
    <a asp-controller="Character" asp-action="Add"
       class="btn btn-primary">Add New Character</a>
    <a asp-controller="Class" asp-action="Add"
       class="btn btn-primary">Add New Class</a>
    <a asp-controller="Character" asp-action="Add"
       class="btn btn-primary">Add New Ancestry</a>
</div>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Class</th>
            <th>Ancestry</th>
            <th>Level</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var character in Model)
        {
            <tr>
                    <td>@character.FirstName @character.LastName</td>
                    <td>@character.Class.Name</td>
                    <td>@character.Ancestry.AncestryName</td>
                    <td>@character.Level</td>
                    <td>
                        <div>
                            <a asp-controller="Character" asp-action="Details" asp-route-id="@character.CharacterId" class="btn btn-info">View Stats</a>
                        </div>
                     </td>
            </tr>
        }

    </tbody>
</table>
